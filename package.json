{
  "name":"sistema-meta-restaurante",
  "version":"1.1.0",
  "private":true,
  "scripts":{
    "install:all":"npm install --prefix backend && npm install --prefix frontend",
    "backend:dev":"npm run dev --prefix backend",
    "backend:build":"npm run build --prefix backend",
    "backend:db:check":"npm run db:check --prefix backend",
    "backend:db:migrate":"npm run db:migrate --prefix backend",
    "backend:db:seed":"npm run db:seed --prefix backend",
    "backend:setup":"npm run setup --prefix backend",
    "frontend:dev":"npm run dev --prefix frontend",
    "frontend:build":"npm run build --prefix frontend",
    "build":"npm run backend:build && npm run frontend:build"
  }
}
