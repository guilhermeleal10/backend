generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ATENDENTE
}

enum TableStatus {
  DISPONIVEL
  OCUPADA
  RESERVADA
}

enum OrderStatus {
  PENDENTE
  PREPARANDO
  PRONTO
  ENTREGUE
}

model User {
  id String @id @default(uuid())
  nome String
  email String @unique
  senha String
  role Role @default(ATENDENTE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  pedidos Pedido[]
  @@map("users")
}

model Prato {
  id String @id @default(uuid())
  nome String
  descricao String?
  categoria String?
  preco Decimal @default(0) @db.Decimal(10, 2)
  ativo Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  itens ItemPedido[]
  @@map("pratos")
}

model Mesa {
  id String @id @default(uuid())
  nome String
  lugares Int @default(2)
  status TableStatus @default(DISPONIVEL)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  pedidos Pedido[]
  @@map("mesas")
}

model Cliente {
  id String @id @default(uuid())
  nome String
  telefone String?
  email String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  pedidos Pedido[]
  @@map("clientes")
}

model Pedido {
  id String @id @default(uuid())
  clienteId String @map("cliente_id")
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  mesaId String? @map("mesa_id")
  mesa Mesa? @relation(fields: [mesaId], references: [id], onDelete: SetNull)
  usuarioId String @map("usuario_id")
  usuario User @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  status OrderStatus @default(PENDENTE)
  observacoes String?
  total Decimal @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  itens ItemPedido[]
  @@map("pedidos")
}

model ItemPedido {
  id String @id @default(uuid())
  pedidoId String @map("pedido_id")
  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pratoId String @map("prato_id")
  prato Prato @relation(fields: [pratoId], references: [id], onDelete: Restrict)
  quantidade Int @default(1)
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)
  @@index([pedidoId])
  @@index([pratoId])
  @@map("itens_pedido")
}
